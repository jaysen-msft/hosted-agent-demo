# -------------------------------------------------------------------
# LangChain Financial PDF Agent -> Microsoft Foundry Hosted Agent
# Sample .env file
#
# Rename this file to .env and fill in your real values.
# Do NOT commit this file to GitHub.
# -------------------------------------------------------------------

# =========================
# Azure OpenAI / Foundry model
# =========================
AZURE_OPENAI_ENDPOINT=https://<your-azure-openai-or-foundry-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-azure-openai-api-key>
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Deployment name in Azure OpenAI / Foundry
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# Optional model behavior
TEMPERATURE=0
MAX_TOKENS=2000


# =========================
# PDF / local RAG settings
# =========================
# Path to your sample PDF portfolio statement
FINANCIAL_PDF_PATH=./sample_financial_portfolio_statement.pdf

# Local vector store folder
VECTOR_STORE_PATH=./storage/faiss_financial_portfolio

# Number of chunks to retrieve from PDF context
TOP_K=5


# =========================
# Azure AI Foundry project
# =========================
# Example format:
# https://<your-foundry-resource>.services.ai.azure.com/api/projects/<your-project-name>
AZURE_AI_PROJECT_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/api/projects/<your-project-name>

# Azure subscription/resource metadata for deployment commands
AZURE_SUBSCRIPTION_ID=<your-subscription-id>
AZURE_RESOURCE_GROUP=<your-resource-group>
AZURE_FOUNDRY_ACCOUNT_NAME=<your-foundry-account-name>
AZURE_FOUNDRY_PROJECT_NAME=<your-foundry-project-name>
AZURE_LOCATION=eastus2


# =========================
# Hosted agent settings
# =========================
HOSTED_AGENT_NAME=financial-portfolio-langchain-agent
HOSTED_AGENT_DISPLAY_NAME=Financial Portfolio LangChain Agent
HOSTED_AGENT_DESCRIPTION=LangChain/LangGraph agent that analyzes synthetic financial portfolio PDFs and produces risk/allocation insights.

# Container/App settings if deploying the hosted agent as containerized code
ACR_NAME=<your-acr-name>
CONTAINER_IMAGE_NAME=financial-portfolio-agent
CONTAINER_IMAGE_TAG=v1
CONTAINER_PORT=8000


# =========================
# Observability
# =========================
# Application Insights / Log Analytics
APPLICATIONINSIGHTS_CONNECTION_STRING=<your-application-insights-connection-string>
LOG_ANALYTICS_WORKSPACE_ID=<your-log-analytics-workspace-id>

# OpenTelemetry
OTEL_SERVICE_NAME=financial-portfolio-langchain-agent
OTEL_TRACES_EXPORTER=azuremonitor
OTEL_METRICS_EXPORTER=azuremonitor
OTEL_LOGS_EXPORTER=azuremonitor

# LangSmith is optional. Leave blank if not using it.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=financial-portfolio-foundry-agent


# =========================
# Optional Azure AI Search
# =========================
# Only needed if you replace local FAISS with Azure AI Search
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_SEARCH_API_KEY=<your-search-admin-or-query-key>
AZURE_SEARCH_INDEX_NAME=financial-portfolio-index


# =========================
# Runtime/auth mode
# =========================
# For local notebook use: key
# For production in Azure, prefer: managed_identity
AUTH_MODE=key

# Optional Managed Identity client ID if using user-assigned managed identity
AZURE_CLIENT_ID=
